# Local development defaults. Copy to .env and change values for your machine.
# The dev database is an embedded PostgreSQL instance started by `npm run dev:db`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/school_erp
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Session cookie lifetime in days
SESSION_TTL_DAYS=7
# Set to "true" only if you know you are serving over HTTPS
COOKIE_SECURE=false
# Optional external notification delivery (email/SMS/WhatsApp gateway).
# Leave unset to keep the outbox honest: messages are marked "blocked" and are
# never reported as sent. The adapter posts JSON:
# { channel, to, subject, body } with a Bearer token, and must return { id }.
# NOTIFICATION_PROVIDER_URL=https://gateway.example.com/send
# NOTIFICATION_PROVIDER_TOKEN=
# NOTIFICATION_PROVIDER_NAME=webhook
